# ── Desenvolvimento ────────────────────────────────────────────────
POSTGRES_DB=hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Email (Resend API — funciona no Railway, sem SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Liga de TI <noreply@ligadeti.com.br>
VITE_WHATSAPP_LINK=https://chat.whatsapp.com/seu-link-aqui

# ── Produção (Railway) ─────────────────────────────────────────────
# SECRET_KEY=          # obrigatório, sem fallback em produção
# DEBUG=False
# ALLOWED_HOSTS=       # ex: meu-app.up.railway.app
# CORS_ALLOWED_ORIGINS=# ex: https://meu-frontend.up.railway.app

# DATABASE_URL=        # fornecido automaticamente pelo Railway Postgres

# Email em produção — EMAIL_BACKEND é forçado para ResendBackend em production.py
# RESEND_API_KEY=re_xxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=Liga de TI <noreply@ligadeti.com.br>

# Admin inicial criado pelo entrypoint na primeira inicialização
# DJANGO_ADMIN_USERNAME=
# DJANGO_ADMIN_PASSWORD=
# DJANGO_ADMIN_EMAIL=

# VITE_WHATSAPP_LINK=https://chat.whatsapp.com/seu-link-aqui
# Celery / e-mail assíncrono
# REDIS_URL=redis://localhost:6379/0
# Em desenvolvimento sem Redis, ligue o modo eager: a task roda no próprio
# processo e o e-mail sai direto (no console, com o EMAIL_BACKEND padrão).
# CELERY_TASK_ALWAYS_EAGER=True

# Entregáveis (Fase 4)
# Em produção, aponte para o volume do Railway montado no serviço do backend.
# MEDIA_ROOT=/app/media
# Teto por arquivo enviado pelo candidato, em bytes (padrão 10 MB).
# MAX_UPLOAD_BYTES=10485760
