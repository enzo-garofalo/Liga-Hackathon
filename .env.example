# ── Desenvolvimento ────────────────────────────────────────────────
POSTGRES_DB=hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Email (Gmail SMTP) — em dev usa console por padrão; troque para smtp em prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=Liga de TI <seuemail@gmail.com>
EMAIL_HOST_PASSWORD=empe sdrd metu qotd
VITE_WHATSAPP_LINK=https://chat.whatsapp.com/seu-link-aqui

# ── Produção (Railway) ─────────────────────────────────────────────
# SECRET_KEY=          # obrigatório, sem fallback em produção
# DEBUG=False
# ALLOWED_HOSTS=       # ex: meu-app.up.railway.app
# CORS_ALLOWED_ORIGINS=# ex: https://meu-frontend.up.railway.app

# DATABASE_URL=        # fornecido automaticamente pelo Railway Postgres

# Email em produção — EMAIL_BACKEND é forçado para SMTP em production.py
# EMAIL_HOST_USER=seuemail@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx  ← App Password do Google
# DEFAULT_FROM_EMAIL=Liga de TI <seuemail@gmail.com>

